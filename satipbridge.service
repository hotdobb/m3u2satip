# m3u2satip as a systemd service.
#
# Template: the paths assume the files live in /opt/m3u2satip and the
# service runs as its own user "m3u2satip". Adjust User, Group and the
# three paths if you put it elsewhere - see README.md, "Install".
#
#   sudo cp satipbridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now satipbridge

[Unit]
Description=m3u2satip: IPTV playlists as a DVB-C network for SAT>IP TVs
Documentation=https://github.com/Hotdobb/m3u2satip
# Only start once the network is really up - on start the bridge downloads
# the channel list and joins multicast groups.
Wants=network-online.target
After=network-online.target
# Never give up restarting. If port 554 is taken for a while (another
# SAT>IP server enabled by a package update, say), the bridge comes back by
# itself as soon as it is free again - instead of staying dead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=m3u2satip
Group=m3u2satip
WorkingDirectory=/opt/m3u2satip

# Port 554 is below 1024 and normally reserved for root. Instead of running
# the whole service as root, it gets exactly the one right it needs for
# that - and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# --bundle-size 8: eight channels per virtual cable frequency. Fewer
# frequency changes while scanning and zapping, and it costs no bandwidth,
# because the bridge only fetches the channel that is actually watched.
# CAUTION: changing it moves all channels to other frequencies, and the
# TVs need a new channel scan.
# The sources themselves are set in the control panel (http://<host>:55000/).
ExecStart=/usr/bin/python3 /opt/m3u2satip/satipbridge.py \
          --source init7 --bundle-size 8

# If it fails, it comes back by itself - important for programmed
# recordings with nobody sitting next to it.
Restart=always
RestartSec=5

# The log goes to the journal:  journalctl -u satipbridge -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=satipbridge

# Some hardening without getting in the bridge's way. It needs the network
# and its own directory (state files, PID cache), nothing else.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/m3u2satip
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
